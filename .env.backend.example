# Server-only settings. Supply real values outside the repository.
OVU_BACKEND=mariadb
# Local loopback only. Omit this setting in production, which requires HTTPS.
OVU_LOCAL_DEVELOPMENT=true
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ovu_main
DB_USER=ovu_main_app
DB_PASSWORD=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CERTIFICATE_SIGNING_SECRET=
CERTIFICATE_HMAC_SECRET=
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=
